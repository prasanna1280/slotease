# =============================================================================
# SlotEase - PRODUCTION environment for docker-compose.prod.yml (Hostinger VPS)
#
#   cp deploy/production.env.example .env
#   nano .env            # replace every CHANGE_ME value
#   chmod 600 .env
#   ./deploy/deploy.sh
#
# docker-compose.prod.yml forces ENVIRONMENT=production, builds DATABASE_URL from the
# POSTGRES_* values and sets FRONTEND_URL / CORS_ORIGINS to https://$DOMAIN.
# It also points RATE_LIMIT_STORAGE_URI at the bundled redis service (shared rate-limit counters).
# =============================================================================

# --- Domain --------------------------------------------------------------------
# DNS A record must point at the VPS IP before the first start (Caddy gets HTTPS for it).
DOMAIN=CHANGE_ME.example.com

# --- Database ------------------------------------------------------------------
POSTGRES_USER=slotease
# Hex only (it is embedded in the database URL):   openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=slotease

# --- Auth ----------------------------------------------------------------------
# openssl rand -hex 32     (or: python3 -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- App -----------------------------------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=INFO
# 2 workers fit a KVM 1/KVM 2 plan comfortably.
WEB_CONCURRENCY=2

# --- Email (console log when both Resend and SMTP are empty) ------------------
EMAIL_FROM=SlotEase <bookings@CHANGE_ME.example.com>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Razorpay ------------------------------------------------------------------
# Keys: Razorpay Dashboard -> Account & Settings -> API Keys (use live keys in production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Plan: Subscriptions -> Plans -> Rs 499 monthly
RAZORPAY_PLAN_ID=
# Webhook: Settings -> Webhooks -> URL https://<DOMAIN>/api/v1/billing/webhook
# events: subscription.activated, subscription.charged, subscription.pending,
#         subscription.halted, subscription.cancelled, subscription.completed
RAZORPAY_WEBHOOK_SECRET=

# --- Frontend build ------------------------------------------------------------
# Leave empty: the SPA calls /api on the same domain.
VITE_API_URL=
