# =============================================================================
# SlotEase - environment template (root .env, used by docker compose)
#
# Docker runs ONLY on the VPS:
#   cp deploy/production.env.example .env (preferred) or this file, then change every
#   value marked  [CHANGE IN PRODUCTION].
# Local development does NOT use Docker: copy the app keys into backend/.env with
#   DATABASE_URL=sqlite:///./slotease.db   (or postgresql+psycopg://...@localhost:5432/slotease)
#   FRONTEND_URL=http://localhost:5173  CORS_ORIGINS=http://localhost:5173
# and run uvicorn + `npm run dev` (see deploy/README.md "Local development").
#
# .env is git-ignored. Never commit real secrets.
# =============================================================================

# --- Database (Postgres container) -------------------------------------------
POSTGRES_USER=slotease
# [CHANGE IN PRODUCTION] use URL-safe characters only (it is embedded in DATABASE_URL):
#   openssl rand -hex 24
POSTGRES_PASSWORD=slotease
POSTGRES_DB=slotease
# Composed for the compose "db" service. docker-compose*.yml always overrides it from the
# POSTGRES_* values above, so you normally never edit it.
DATABASE_URL=postgresql+psycopg://slotease:slotease@db:5432/slotease

# --- Auth ----------------------------------------------------------------------
# [CHANGE IN PRODUCTION] at least 32 random chars; the API refuses to start in production
# with the default. Generate with one of:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- App -----------------------------------------------------------------------
# development | production   (docker-compose.prod.yml forces production)
ENVIRONMENT=development
LOG_LEVEL=INFO
# Public URL of the web app (used in emails / redirects).
# [CHANGE IN PRODUCTION] docker-compose.prod.yml sets it to https://$DOMAIN automatically.
FRONTEND_URL=http://localhost:8080
# Comma-separated. [CHANGE IN PRODUCTION] prod compose sets it to https://$DOMAIN automatically.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# Rate-limit counters: memory:// (per process) for local dev; compose uses redis://redis:6379/0
RATE_LIMIT_STORAGE_URI=memory://
# gunicorn worker processes (2 suits a 1-2 vCPU VPS).
WEB_CONCURRENCY=2
# Host port for the local stack (docker-compose.yml only).
FRONTEND_PORT=8080

# --- Domain (production only) --------------------------------------------------
# [CHANGE IN PRODUCTION] domain or subdomain whose DNS A record points at the VPS.
# Caddy obtains the HTTPS certificate for it automatically.
DOMAIN=slotease.example.com

# --- Email (optional - emails are logged to the console when empty) -----------
# [CHANGE IN PRODUCTION] a sender on a domain verified with your provider.
EMAIL_FROM=SlotEase <bookings@example.com>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Razorpay (optional - billing shows "not configured" when empty) ----------
# [CHANGE IN PRODUCTION] live keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Subscription plan (Rs 499/month) created in Razorpay -> Subscriptions -> Plans.
RAZORPAY_PLAN_ID=
# Webhook URL: https://<DOMAIN>/api/v1/billing/webhook
RAZORPAY_WEBHOOK_SECRET=

# --- Frontend build ------------------------------------------------------------
# Empty = same origin (nginx proxies /api). Leave empty for Docker / production.
VITE_API_URL=
